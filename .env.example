# ==============================================================================
# DownBeat Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud / Firebase Project Configuration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="downbeat-live"
FIREBASE_STORAGE_BUCKET="downbeat-live.firebasestorage.app"

# Service Account credentials for server (Firebase Admin SDK)
# In production on Cloud Run, default credentials are used automatically.
# For local development, provide the path to your service account JSON file
# OR provide base64-encoded credentials.
GOOGLE_APPLICATION_CREDENTIALS="./service-account-key.json"
# FIREBASE_SERVICE_ACCOUNT_BASE64=""

# Web Client Firebase Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDummyDevKeyForDownBeatLocalTesting"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="downbeat-live.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="downbeat-live"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="downbeat-live.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# Backend Service (Cloud Run Node.js + TypeScript)
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT="8088"
# Fake "dev-mock-token-*" logins for local testing only (ignored when NODE_ENV=production)
ALLOW_DEV_TOKENS="false"
NEXT_PUBLIC_ALLOW_DEV_LOGIN="false"
JWT_SECRET="downbeat-super-secret-session-signing-key-change-in-production-min32chars"
CORS_ORIGIN="http://localhost:3000,https://downbeat-live.web.app"
WEB_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Google Gemini & Lyria AI Configuration
# ------------------------------------------------------------------------------
# Get your Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Models (Use stable latest models — do NOT use Gemini 1.5)
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-3.6-flash"
# Beat Jam streams from Lyria RealTime (experimental)
LYRIA_REALTIME_MODEL="models/lyria-realtime-exp"

# ------------------------------------------------------------------------------
# UDP Relay Server (Compute Engine e2-micro VM)
# ------------------------------------------------------------------------------
# Address the relay binds to (0.0.0.0 = all interfaces)
RELAY_BIND_HOST="0.0.0.0"
RELAY_HOST="127.0.0.1"
RELAY_PORT="48000"
RELAY_SECRET="downbeat-relay-shared-secret-auth-key-change-in-prod"
# Public DNS or IP for clients to reach the UDP relay:
# Public IPv4 address the plugins send relay traffic to (must be an IP, not a hostname).
# Server and relay must share RELAY_SECRET: the server signs relay tickets with it.
PUBLIC_RELAY_IP="127.0.0.1"

# ------------------------------------------------------------------------------
# Plugin Device Pairing & Network Defaults
# ------------------------------------------------------------------------------
PAIRING_CODE_TTL_MINUTES="10"
DEFAULT_JITTER_BUFFER_MS="40"
STUN_SERVER="stun:stun.l.google.com:19302"
