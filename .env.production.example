# Copy to .env.production (git-ignored) and fill in. Used by scripts/deploy-*.sh.
GCP_PROJECT="downbeat-919f8"
GCP_REGION="us-central1"
RELAY_ZONE="us-central1-a"

# Secrets: generate with   openssl rand -base64 48
JWT_SECRET=""
RELAY_SECRET=""
GEMINI_API_KEY=""

# Models
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-3.6-flash"
LYRIA_REALTIME_MODEL="models/lyria-realtime-exp"

# Filled in by the scripts after the first deploy (or set manually)
PUBLIC_RELAY_IP=""        # static IP of the relay VM (deploy-relay.sh prints it)
SERVER_URL=""             # Cloud Run URL (deploy-server.sh prints it)

# Firebase web config (Project settings -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="downbeat-919f8.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="downbeat-919f8"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="downbeat-919f8.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
